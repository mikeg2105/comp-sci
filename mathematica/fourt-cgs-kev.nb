Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"rk4Solve", "[", 
      RowBox[{
      "t0_", ",", "niini_", ",", "te0_", ",", " ", "ti0_", ",", "tr0_", " ", 
       ",", "h_", ",", "tf_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"t", "=", "t0"}], ",", 
         RowBox[{"ni", "=", "niini"}], ",", 
         RowBox[{"te", "=", "te0"}], ",", " ", 
         RowBox[{"ti", "=", "ti0"}], ",", " ", 
         RowBox[{"tr", "=", "tr0"}], ",", 
         RowBox[{"sol", "=", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"t0", ",", "niini", ",", "te0", ",", " ", "ti0"}], "}"}], 
           "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"t", "<", "tf"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"ni", ",", "te", ",", "ti", ",", "tr"}], "}"}], "=", 
            RowBox[{"rk4Step", "[", 
             RowBox[{
             "t", ",", "ni", ",", "te", ",", "ti", ",", " ", "tr", ",", "h"}],
              "]"}]}], ";", 
           RowBox[{"t", "=", 
            RowBox[{"t", "+", "h"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"sol", ",", 
             RowBox[{"{", 
              RowBox[{"t", ",", "ni", ",", "te", ",", "ti", ",", " ", "tr"}], 
              "}"}]}], "]"}], ";"}]}], "]"}], ";", "sol"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.941638797698862*^9, 3.941638799019346*^9}, {
