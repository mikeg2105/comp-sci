Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"pr", "[", 
    RowBox[{"N_", ",", " ", "Vo_", ",", " ", "T_"}], "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"N", "*", "kb", "*", 
      RowBox[{"T", "/", "Vo"}]}], ")"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"ar", "*", 
       RowBox[{"T", "^", "4"}]}], ")"}], "/", "3"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Et", "[", 
    RowBox[{"N_", ",", "Vo_", ",", "T_"}], "]"}], ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"3", "/", "2"}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{"N", "*", "kb", "*", "T"}], ")"}]}], "+", 
    RowBox[{"(", 
     RowBox[{"Vo", "*", "ar", "*", 
      RowBox[{"T", "^", "4"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"St", "[", 
    RowBox[{"N_", ",", "Vo_", ",", "T_"}], "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"N", "*", "kb", "*", 
     RowBox[{"Log", "[", 
      RowBox[{"Vo", "*", 
       RowBox[{"T", "^", 
        RowBox[{"(", 
         RowBox[{"3", "/", "2"}], ")"}]}]}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"4", "/", "3"}], ")"}], "*", "ar", "*", "Vo", "*", 
     RowBox[{"T", "^", "3"}]}]}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.9241596534089355`*^9, 3.924159663695251*^9}, {
