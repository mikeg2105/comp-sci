Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Adt", "=", 
    RowBox[{"10", "*", "5.0", "*", 
     RowBox[{"10", "^", 
      RowBox[{"(", 
       RowBox[{"-", "18"}], ")"}]}]}]}], ";"}], "  ", 
  RowBox[{"(*", 
   RowBox[{"cm", "^", "2"}], "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"m", "^", "3"}], "/", "s"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kdt", "=", "0.6"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"T0dt", "=", "0.74"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sigvdt", "[", "T_", "]"}], ":=", 
    RowBox[{"Adt", "*", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"T0dt", "-", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "kdt"}], "*", "T"}], "]"}]}], ")"}], "/", 
      RowBox[{"Sqrt", "[", "T", "]"}]}]}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "DT", " ", "fusion", " ", "reaction", " ", "cross", " ", "section", " ", 
    "sigv"}], "*)"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "T", " ", "is", " ", "the", " ", "temperature", " ", "in", " ", "keV"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"sigvdt", "[", "x1", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x1", ",", "0", ",", "120"}], "}"}]}], "]"}], 
  " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{
    RowBox[{"sigvdt", "[", "1", "]"}], ",", "\"\< \>\"", ",", 
    RowBox[{"sigvdt", "[", "10", "]"}], ",", "\"\< \>\"", ",", 
    RowBox[{"sigvdt", "[", "30", "]"}], ",", "\"\<  \>\"", ",", 
    RowBox[{"sigvdt", "[", "50", "]"}]}], "]"}], " ", ";"}]}], "Input",
