Cell[BoxData[{
 RowBox[{
  RowBox[{"AFC", " ", "=", 
   RowBox[{"325", "*", 
    RowBox[{
     RowBox[{"(", "10", ")"}], "^", 
     RowBox[{"(", 
      RowBox[{"-", "3"}], ")"}]}], "*", 
    RowBox[{"(", 
     RowBox[{"10", "^", "8"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FCC", "=", 
   RowBox[{"10", "^", 
    RowBox[{"(", 
     RowBox[{"-", "28"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GAFC", "=", 
   RowBox[{"71.7", "*", 
    RowBox[{"(", 
     RowBox[{"10", "^", "3"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ERFC", " ", "=", 
   RowBox[{"124.3", "*", 
    RowBox[{"(", 
     RowBox[{"10", "^", "3"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sigvdtfc", "[", "T_", "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "/", "T"}], ")"}], "*", 
   RowBox[{"(", 
    RowBox[{"AFC", "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"ERFC", "-", "T"}], ")"}], "^", "2"}], "+", 
       RowBox[{"GAFC", "^", "2"}]}], ")"}]}], ")"}], "*", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", "1.72"}], "*", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"10", "^", "3"}], ")"}], "/", 
      RowBox[{"Sqrt", "[", "T", "]"}]}]}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"sigvdtfc", "[", "x1", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x1", ",", "0", ",", "500000"}], "}"}]}], "]"}], 
  "  "}]}], "Input",
