Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Parameters", "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"numParticles", "=", "10"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Number", " ", "of", " ", "particles"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"timeStep", "=", "0.01"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Time", " ", "step", " ", "size"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"totalTime", "=", "10"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Total", " ", "simulation", " ", "time"}], "*)"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.952065108243704*^9, 3.9520651109045467`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"607f2e1f-bbc4-1042-aa47-62e482339e2c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Wiener", " ", "Process", " ", "Generator"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"wienerProcess", "[", 
     RowBox[{"numSteps_", ",", "timeStep_"}], "]"}], ":=", 
    RowBox[{"Accumulate", "[", 
     RowBox[{
      RowBox[{"Sqrt", "[", "timeStep", "]"}], " ", 
      RowBox[{"RandomVariate", "[", 
       RowBox[{
        RowBox[{"NormalDistribution", "[", 
         RowBox[{"0", ",", "1"}], "]"}], ",", "numSteps"}], "]"}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9520651335143127`*^9, 3.9520651359691944`*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"406824da-68c5-5b41-9116-82b6e817eb6e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Simulate", " ", "Brownian", " ", "Motion"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"simulateBrownianMotion", "[", 
     RowBox[{"numParticles_", ",", "totalTime_", ",", "timeStep_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"numSteps", ",", "times", ",", "particlePaths"}], "}"}], ",", 
      RowBox[{
       RowBox[{"numSteps", "=", 
        RowBox[{"Round", "[", 
         RowBox[{"totalTime", "/", "timeStep"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"times", "=", 
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", "totalTime", ",", "timeStep"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"particlePaths", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Prepend", "[", 
           RowBox[{
            RowBox[{"wienerProcess", "[", 
             RowBox[{"numSteps", ",", "timeStep"}], "]"}], ",", "0"}], "]"}], 
          ",", 
          RowBox[{"{", "numParticles", "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"times", ",", "particlePaths"}], "}"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.952065154419777*^9, 3.9520651562601185`*^9}, 
   3.9520652572363434`*^9},ExpressionUUID->"d2f563f4-5d27-034d-9e0f-\
e468141caf4b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Run", " ", "the", " ", "Simulation"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"times", ",", "particlePaths"}], "}"}], "=", 
     RowBox[{"simulateBrownianMotion", "[", 
      RowBox[{"numParticles", ",", "totalTime", ",", "timeStep"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9520651883096313`*^9, 
  3.9520651904974594`*^9}},ExpressionUUID->"4f5cf337-3144-b248-b00e-\
467efb7f81b6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Visualization", "*)"}], 
  RowBox[{"ListLinePlot", "[", 
   RowBox[{"particlePaths", ",", 
    RowBox[{"DataRange", "->", 
     RowBox[{"{", 
      RowBox[{"0", ",", "totalTime"}], "}"}]}], ",", 
    RowBox[{"PlotLegends", "->", "Automatic"}], ",", 
    RowBox[{"AxesLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Time\>\"", ",", "\"\<Position\>\""}], "}"}]}], ",", 
    RowBox[{"PlotLabel", "->", "\"\<Brownian Motion of Particles\>\""}]}], 
   "]"}]}]], "Input",
