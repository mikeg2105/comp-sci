Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "parameters", " ", "and", " ", "initial", " ", 
    "conditions"}], "*)"}], 
  RowBox[{
   RowBox[{"xMin", "=", "0.01"}], "\n", 
   RowBox[{
    RowBox[{"xMax", "=", "10"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tMax", "=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"a", "=", "2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"initialCondition", "[", "x_", "]"}], ":=", 
    RowBox[{"Exp", "[", 
     RowBox[{"-", "x"}], "]"}]}], " ", 
   RowBox[{"(*", 
    RowBox[{"Example", " ", "initial", " ", "condition"}], "*)"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "the", " ", "Kompaneets", " ", "equation"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kompaneetsEquation", "=", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"n", "[", 
         RowBox[{"t", ",", "x"}], "]"}], ",", "t"}], "]"}], "==", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", 
         RowBox[{"x", "^", "2"}]}], ")"}], " ", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"x", "^", "4"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"a", "*", 
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"n", "[", 
                RowBox[{"t", ",", "x"}], "]"}], ",", "x"}], "]"}]}], "+", 
            RowBox[{"n", "[", 
             RowBox[{"t", ",", "x"}], "]"}], "+", 
            RowBox[{
             RowBox[{"n", "[", 
              RowBox[{"t", ",", "x"}], "]"}], "^", "2"}]}], ")"}]}], ",", 
         "x"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Solve", " ", "the", " ", "PDE", " ", "numerically"}], "*)"}], 
   "\n", 
   RowBox[{
    RowBox[{"solution", "=", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"kompaneetsEquation", ",", 
         RowBox[{
          RowBox[{"n", "[", 
           RowBox[{"0", ",", "x"}], "]"}], "==", 
          RowBox[{"initialCondition", "[", "x", "]"}]}], ",", 
         RowBox[{
          RowBox[{"n", "[", 
           RowBox[{"t", ",", "xMin"}], "]"}], "==", 
          RowBox[{"initialCondition", "[", "xMin", "]"}]}], ",", 
         RowBox[{
          RowBox[{"n", "[", 
           RowBox[{"t", ",", "xMax"}], "]"}], "==", 
          RowBox[{"initialCondition", "[", "xMax", "]"}]}]}], "}"}], ",", "n",
        ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "tMax"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "xMin", ",", "xMax"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "the", " ", "solution"}], "*)"}], "\n", 
   RowBox[{"Plot3D", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{"n", "[", 
        RowBox[{"t", ",", "x"}], "]"}], "/.", " ", "solution"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "xMin", ",", "xMax"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "tMax"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<x\>\"", ",", "\"\<t\>\"", ",", "\"\<n(t, x)\>\""}], 
       "}"}]}], ",", 
     RowBox[{
     "PlotLabel", "->", "\"\<Solution of the Kompaneets Equation\>\""}]}], 
    "]"}], "\n"}]}]], "Input",
 CellChangeTimes->{{3.938703970866583*^9, 3.938703970869583*^9}, {
  3.938704704447523*^9, 3.9387047547868443`*^9}, {3.9387048396657734`*^9, 
