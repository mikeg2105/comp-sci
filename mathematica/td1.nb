 RowBox[{
  RowBox[{"ContSum", "[", "numlist_", "]"}], ":=", " ", 
  RowBox[{"Module", "[", "  ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"result", "=", 
       RowBox[{"numbers", "[", 
        RowBox[{"[", 
         RowBox[{"Length", "[", "numbers", "]"}], "]"}], "]"}]}], ",", "i"}], 
     "}"}], ",", "   ", 
    RowBox[{
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", 
        RowBox[{"Length", "[", 
         RowBox[{"numbers", "-", "1"}], "]"}]}], ",", 
       RowBox[{"i", ">", "1"}], ",", 
       RowBox[{"i", "--"}], ",", " ", 
       RowBox[{"result", "=", 
        RowBox[{
         RowBox[{"numbers", "[", 
          RowBox[{"[", 
           RowBox[{"i", "-", "1"}], "]"}], "]"}], "+", 
         RowBox[{"(", 
          RowBox[{"1", "/", "result"}], ")"}]}]}]}], "]"}], ";", "result"}]}],
